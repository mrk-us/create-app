{
  "name": "@mrk-us/create-app",
  "version": "0.1.2",
  "description": "Create a composable mrk.us application",
  "type": "module",
  "bin": {
    "create-app": "./dist/index.js"
  },
  "files": [
    "biome.format.json",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --target=bun --format=esm --outfile=./dist/index.js",
    "check": "ultracite check",
    "dev": "bun run ./src/index.ts",
    "fix": "ultracite fix",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bun run check && bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@biomejs/biome": "2.5.11",
    "@clack/prompts": "1.7.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "7.0.2",
    "ultracite": "7.10.7"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
